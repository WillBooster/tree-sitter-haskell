{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "haskell",
      "camelcase": "Haskell",
      "scope": "source.haskell",
      "path": ".",
      "file-types": ["hs", "hs-boot"],
      "highlights": "queries/highlights.scm",
      "tags": "queries/tags.scm",
      "injection-regex": "^(hs|haskell)$"
    },
    {
      "name": "hsc",
      "camelcase": "Hsc",
      "scope": "source.hsc",
      "path": "hsc",
      "file-types": ["hsc"],
      "highlights": ["queries/highlights.scm", "hsc/queries/highlights.scm"],
      "tags": "queries/tags.scm",
      "injection-regex": "^hsc$",
      "injections": ["queries/injections.scm", "hsc/queries/injections.scm"]
    }
  ],
  "metadata": {
    "version": "0.23.1",
    "license": "MIT",
    "description": "Haskell grammar for tree-sitter",
    "authors": [
      {
        "name": "WillBooster Inc."
      }
    ],
    "links": {
      "repository": "https://github.com/WillBooster/tree-sitter-haskell"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": true,
    "swift": false,
    "zig": false
  }
}
