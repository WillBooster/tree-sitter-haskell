#!/usr/bin/env bash

set -euo pipefail

cd "$(dirname "$0")/.."

mkdir -p .tmp/fuzz
parser=
trap '[[ -z $parser ]] || rm -f "$parser"' EXIT
export TREE_SITTER_SEED=${TREE_SITTER_SEED:-1}
export TREE_SITTER_ITERATIONS=${TREE_SITTER_ITERATIONS:-1000}
export TREE_SITTER_EDITS=${TREE_SITTER_EDITS:-10}
languages=$(node -e 'const {grammars} = require("./tree-sitter.json"); console.log(grammars.map(({name, path}) => `${name}\t${path ?? "."}`).join("\n"));')
while IFS=$'\t' read -r language grammar; do
  parser=$(mktemp ".tmp/fuzz/$language.XXXXXX")
  script/tree-sitter build "$grammar" -o "$parser"
  script/tree-sitter fuzz --lib-path "$parser" --lang-name "$language"
  rm -f "$parser"
  parser=
done <<< "$languages"
