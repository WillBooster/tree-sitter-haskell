#!/usr/bin/env bash

set -euo pipefail

cd "$(dirname "$0")/.."

mkdir -p .tmp/fuzz
# Runs in the same checkout may overlap, so each builds the parser into a file of its own.
parser=$(mktemp .tmp/fuzz/haskell.XXXXXX)
trap 'rm -f "$parser"' EXIT
script/tree-sitter build -o "$parser"
export TREE_SITTER_SEED=${TREE_SITTER_SEED:-1}
export TREE_SITTER_ITERATIONS=${TREE_SITTER_ITERATIONS:-1000}
export TREE_SITTER_EDITS=${TREE_SITTER_EDITS:-10}
script/tree-sitter fuzz --lib-path "$parser" --lang-name haskell
